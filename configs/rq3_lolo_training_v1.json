    "truncation": "right",
    "padding": "dynamic_batch_max_768"
  },
  "dataset_contract": {
    "loader_config": "configs/dataset_loader_v1.json",
    "track": "CLEAN_STRICT_LOLO",
    "target_languages": [
      "C",
      "C#",
      "C++",
      "Go",
      "Java",
      "JavaScript",
      "Python"
