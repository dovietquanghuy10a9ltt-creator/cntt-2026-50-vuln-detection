  "role": "PRIMARY_CONFIRMATORY_TRAINING",
  "protocol_version": "v1",
  "research_question": "RQ3",
  "purpose": "Train UniXcoder on leave-one-language-out vulnerability detection across 7 target languages and 5 seeds under CLEAN_STRICT_LOLO, and evaluate zero-shot transfer on held-out target language clean test population.",
  "governance": {
