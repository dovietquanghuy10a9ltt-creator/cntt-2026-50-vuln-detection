{
  "contract_name": "week3_training_pilot_v1",
  "contract_revision": "v1.1-governance-clarification",
  "clarification_scope": "Test-access semantics only; no pilot population, hyperparameter grid, selection rule, model architecture, or research question changed.",
  "status": "FROZEN",
  "role": "IMPLEMENTATION_DEVELOPMENT_PILOT",
  "protocol_version": "v1",
  "purpose": "Select one global training recipe for later Mono, Multi, and strict LOLO execution without per-language or per-target tuning.",
  "governance": {
    "confirmatory_result": false,
    "allowed_for_rq_performance_claims": false,
