    "post_outcome_candidate_expansion_forbidden": true
  },
  "model": {
    "name": "microsoft/unixcoder-base-nine",
    "revision": "5f0dc256eb0904af496d427451da5d7f90261676",
    "full_encoder_finetuning": true,
    "classification_head": {
      "pooling": "attention_mask_mean_over_non_padding_positions",
      "hidden_size": 768,
      "classifier": "linear",
      "num_labels": 2,
      "extra_mlp": false
    }
  },
  "objective": {
    "loss": "CrossEntropyLoss",
    "class_weights": null
  },
  "optimizer": {
    "family": "AdamW",
    "pilot_weight_decay": 0.0,
    "adam_epsilon": 1e-08
  },
  "input_contract": {
    "tokenization_config": "configs/tokenization_v1.json",
    "max_length": 768
  },
  "dataset_contract": {
    "loader_config": "configs/dataset_loader_v1.json",
    "track": "CLEAN_EXACT_HASH"
  },
  "pilot_train_population": {
    "split": "train",
    "languages": [
      "C",
      "C#",
      "C++",
      "Go",
      "Java",
      "JavaScript",
      "Python"
    ],
    "targets": [
      0,
      1
    ],
    "units_per_language_target_cell": 128,
    "expected_total_units": 1792,
    "sampling_with_replacement": false,
    "selection": {
      "method": "salted_sha256_order",
      "salt": "week3-training-pilot-v1",
      "key_expression": "sha256(salt + '|' + unit_id).hexdigest()",
      "sort_order": "ascending",
      "take_per_cell": 128
    }
  },
  "pilot_validation_population": {
    "split": "validation",
    "use_complete_split": true,
    "expected_total_units": 1937,
    "rebalance": false,
    "checkpoint_score": {
      "per_language_metric": "vulnerable_class_f1",
      "aggregation": "equal_weight_arithmetic_mean",
      "languages": [
        "C",
        "C#",
        "C++",
        "Go",
        "Java",
        "JavaScript",
        "Python"
      ]
    }
  },
  "pilot_execution": {
    "seed": 17,
    "physical_batch_size": 8,
    "gradient_accumulation_steps": 1,
    "effective_batch_size": 8,
    "precision": "fp32",
    "scheduler": "linear_decay",
    "warmup_ratio": 0.1,
    "gradient_clipping_max_norm": 1.0,
    "max_epochs": 5,
    "evaluation_frequency": "every_epoch",
    "early_stopping": false
  },
  "learning_rate_candidates": [
    1e-05,
    2e-05,
    5e-05
  ],
  "selection_rule": {
    "within_candidate": {
      "criterion": "maximum_validation_checkpoint_score",
      "checkpoint_tie_break": "earliest_epoch"
    },
    "across_candidates": {
      "criterion": "highest_selected_validation_checkpoint_score",
      "exact_score_tie_break": "smaller_learning_rate"
    }
  },
  "budget_boundary_guard": {
    "boundary_epoch": 5,
